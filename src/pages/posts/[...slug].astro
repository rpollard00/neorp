---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import { numberPosts } from "../../utils/posts";

export const getStaticPaths = (async () => {
  const posts = numberPosts(await getCollection("posts"));
  return posts.map((entry, i) => ({
    params: { slug: entry.post.id },
    props: { entry, older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, older } = Astro.props;
const { Content } = await render(entry.post);
---

<PostLayout entry={entry} older={older}>
  <Content />
</PostLayout>
