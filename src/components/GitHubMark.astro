---
const ICON = [
  "..#####..",
  ".#######.",
  "###.#.###",
  "##.....##",
  "##.....##",
  "###...###",
  ".#.#.###.",
  ".##..###.",
  "..##.##..",
];
const SIZE = ICON.length;
const SCALE = 2;

const path = ICON.flatMap((row, y) =>
  [...row].flatMap((cell, x) => (cell === "#" ? [`M${x} ${y}h1v1h-1z`] : [])),
).join("");
---

<svg
  viewBox={`0 0 ${SIZE} ${SIZE}`}
  width={SIZE * SCALE}
  height={SIZE * SCALE}
  shape-rendering="crispEdges"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={path}></path>
</svg>

<style>
  svg {
    display: block;
  }
</style>
