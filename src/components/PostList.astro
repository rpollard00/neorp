---
import {
  formatDate,
  formatDateAttr,
  formatNumber,
  postUrl,
  readingMinutes,
  type NumberedPost,
} from "../utils/posts";

interface Props {
  posts: NumberedPost[];
}

const { posts } = Astro.props;
---

{posts.length === 0 ? (
  <p class="empty">Got bored before writing anything...</p>
) : (
  <ol class="posts">
    {posts.map(({ post, number }) => (
      <li>
        <a
          class="post"
          href={postUrl(post)}
          aria-labelledby={`post-${number}-title`}
          aria-describedby={`post-${number}-meta`}
        >
          <span class="num">{formatNumber(number)}</span>
          <span class="text">
            <span class="meta" id={`post-${number}-meta`}>
              <time datetime={formatDateAttr(post.data.pubDate)}>
                {formatDate(post.data.pubDate)}
              </time>
              <span>{readingMinutes(post)} min</span>
            </span>
            <span class="title" id={`post-${number}-title`}>
              {post.data.title}
            </span>
            {post.data.description && (
              <span class="desc">{post.data.description}</span>
            )}
          </span>
        </a>
      </li>
    ))}
  </ol>
)}

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border-bottom: 1px solid var(--ink);
  }

  .post {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.75rem;
    padding: 1.25rem 0;
    text-decoration: none;
  }

  .num {
    padding-top: 0.35rem;
    font: 500 0.875rem/1 var(--mono);
  }

  .text {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .post:hover .title,
  .post:focus-visible .title {
    color: var(--pop);
  }

  .desc {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .empty {
    color: var(--muted);
  }

  @media (max-width: 40rem) {
    .post {
      grid-template-columns: 2.25rem 1fr;
    }
  }
</style>
