---
import Layout from "./Layout.astro";
import Plate from "../components/Plate.astro";
import { plateFor } from "../lib/plates";
import {
  formatDate,
  formatDateAttr,
  formatPlateDate,
  postUrl,
  readingMinutes,
  type NumberedPost,
} from "../utils/posts";

interface Props {
  entry: NumberedPost;
  older: NumberedPost | undefined;
}

const { entry, older } = Astro.props;
const { post, number } = entry;
const { title, description, pubDate, tags } = post.data;
const plate = plateFor(post);
---

<Layout title={title} description={description}>
  <article>
    <Plate
      url={plate.url}
      palette={plate.palette}
      number={number}
      caption={formatPlateDate(pubDate)}
      size="hero"
    />
    <p class="meta">
      <time datetime={formatDateAttr(pubDate)}>{formatDate(pubDate)}</time>
      <span>{readingMinutes(post)} min read</span>
      {tags?.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </p>
    <h1>{title}</h1>
    {description && <p class="dek">{description}</p>}
    <div class="checker break" aria-hidden="true"></div>

    <div class="prose">
      <slot />
    </div>

    <nav class="post-nav" aria-label="More posts">
      {older && (
        <a href={postUrl(older.post)}>
          <span class="label">Older</span>
          {older.post.data.title}
        </a>
      )}
      <a class="index" href="/posts/">
        <span class="label">Index</span>
        All posts
      </a>
    </nav>
  </article>
</Layout>

<style>
  .meta {
    gap: 0.25rem 1rem;
    margin: 0 0 1rem;
  }

  .dek {
    margin: 0 0 2rem;
    color: var(--muted);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .break {
    height: 8px;
    margin-bottom: 2.5rem;
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--text);
  }

  .post-nav a {
    text-decoration: none;
  }

  .post-nav a:hover {
    color: var(--pop-text);
  }

  .index {
    margin-left: auto;
    text-align: right;
  }

  .label {
    display: block;
    color: var(--muted);
    font: 0.75rem/1.4 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>
