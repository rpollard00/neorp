---
import "../styles/dither-mask.css";

interface Props {
  title?: string;
  description?: string;
}

const SITE_NAME = "Neorp";
const { title, description } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <a href="/">Home</a>
      <a href="/posts/">Posts</a>
      <a href="/about/">About</a>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --fg: #1a1a1a;
    --muted: #666;
    --accent: #0b5cad;
    /* The page is one solid colour. The header band starts as a second solid
       colour and ordered-dithers into the body colour over its last stretch.
       Retheme by swapping these two tokens. */
    --bg: #ffffff;
    --bg-header: #cbd8ea;
    --header-band: 10rem;
    --max-width: 46rem;
    /* No dark mode, so pin the canvas the browser paints before CSS applies. */
    color-scheme: light;
  }

  html {
    position: relative;
    background-color: var(--bg);
  }

  /* Header band: solid --bg-header down to the header's bottom edge, then
     ordered-dithered into --bg by the bottom of the band. Absolute rather
     than fixed, so it scrolls away instead of sitting under the content. The
     mask holds one pixel per dither dot and is tiled horizontally at a fixed
     height, which keeps the dots square at any viewport and independent of
     its width. --dither-mask is the generated data URI (see src/styles/
     dither-mask.css): a mask-image is not render-blocking, so fetching the
     mask as a file would let the band paint solid for a frame first. */

  html::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: var(--header-band);
    pointer-events: none;
    background-color: var(--bg-header);
    -webkit-mask-image: var(--dither-mask);
    mask-image: var(--dither-mask);
    -webkit-mask-size: auto var(--header-band);
    mask-size: auto var(--header-band);
    -webkit-mask-repeat: repeat-x;
    mask-repeat: repeat-x;
    image-rendering: pixelated;
    /* Above the page background, below every in-flow box. */
    z-index: -1;
  }

  body {
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
    max-width: var(--max-width);
    color: var(--fg);
    font-family:
      system-ui,
      -apple-system,
      "Segoe UI",
      Roboto,
      "Helvetica Neue",
      Arial,
      sans-serif;
    line-height: 1.6;
  }

  header {
    display: flex;
    gap: 1rem;
    padding-bottom: 1rem;
    margin-bottom: 8rem;
  }

  a {
    text-decoration: none;
    color: var(--accent);
  }

  main {
    min-height: 60vh;
  }

  h1 {
    font-size: 1.9rem;
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }

  h2 {
    font-size: 1.4rem;
    margin-top: 2rem;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  pre {
    padding: 1rem;
    overflow-x: auto;
    border-radius: 6px;
    font-size: 0.9rem;
  }

  code {
    font-family:
      ui-monospace, "Cascadia Code", "Source Code Pro", Menlo, Consolas,
      monospace;
  }

  :where(p, ul, ol, blockquote) {
    margin-block: 1rem;
  }
</style>
