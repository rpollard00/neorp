---
import "../styles/dither-mask.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import Wordmark from "../components/Wordmark.astro";
import { SITE } from "../site";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;

const NAV = [
  { href: "/posts/", label: "Posts" },
  { href: "/about/", label: "About" },
  { href: SITE.feed, label: "RSS" },
];
const current = (href: string) =>
  Astro.url.pathname === href ? "page" : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
        }
      }
    </script>
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href={SITE.feed}
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="masthead">
      <div class="wrap site">
        <a class="home" href="/" aria-label="Neorp home">
          <Wordmark scale={3} />
        </a>
        <nav aria-label="Main">
          {NAV.map(({ href, label }) => (
            <a href={href} aria-current={current(href)}>
              {label}
            </a>
          ))}
          <ThemeToggle />
        </nav>
      </div>
    </header>
    <div class="edge" aria-hidden="true"></div>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="edge edge-up" aria-hidden="true"></div>
      <div class="foot">
        <div class="wrap">
          <Wordmark scale={2} />
          <span>Written by hand, built with Astro</span>
          <a href={SITE.feed}>RSS</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --page: light-dark(#f5f0e6, #3b3a45);
    --text: light-dark(#1c1a24, #e9e8ee);
    --muted: light-dark(#5f596b, #b9b8c8);
    --chrome: #1c1a24;
    --on-chrome: #f5f0e6;
    --muted-on-chrome: #a7a1b3;
    --pop: light-dark(#2b3dff, #cc0078);
    --on-pop: #f5f0e6;
    --pop-text: light-dark(#2b3dff, #ff85c2);
    --sans:
      "Inter", "Helvetica Neue", "Noto Sans", Arial, system-ui, sans-serif;
    --mono:
      "JetBrains Mono", "IBM Plex Mono", ui-monospace, "Noto Sans Mono",
      "DejaVu Sans Mono", monospace;
    --measure: 40rem;
    --gutter: 1.25rem;
    --px: 4px;
    --checker-mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='2' height='2' viewBox='0 0 2 2' shape-rendering='crispEdges'><rect width='1' height='1'/><rect x='1' y='1' width='1' height='1'/></svg>");
  }

  /* Without light-dark() every themed token is invalid, not light, so these
     browsers get the light theme explicitly. */
  @supports not (color: light-dark(#000, #000)) {
    :root {
      color-scheme: light;
      --page: #f5f0e6;
      --text: #1c1a24;
      --muted: #5f596b;
      --pop: #2b3dff;
      --pop-text: #2b3dff;
    }
  }

  :root[data-theme="light"] {
    color-scheme: light;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
  }

  @media (max-width: 40rem) {
    :root {
      --px: 3px;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--page);
    scrollbar-gutter: stable;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
    color: var(--text);
    font: 1.0625rem/1.7 var(--sans);
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
  }

  .masthead :focus-visible,
  .site-footer :focus-visible {
    outline-color: var(--on-chrome);
  }

  .wrap {
    width: 100%;
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .masthead {
    background: var(--chrome);
    color: var(--on-chrome);
  }

  .site {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
  }

  .home {
    display: inline-flex;
  }

  .site nav {
    display: flex;
    gap: 1.5rem;
    font: 500 0.8125rem/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .site nav a,
  .foot a {
    text-decoration: none;
  }

  .site nav a:hover,
  .site nav a[aria-current="page"],
  .foot a:hover {
    text-decoration: underline 2px;
    text-underline-offset: 4px;
  }

  /* Chrome through the colourless dither mask: one mask pixel per --px dot. */
  .edge {
    height: calc(12 * var(--px));
    background: var(--chrome);
    -webkit-mask-image: var(--dither-mask);
    mask-image: var(--dither-mask);
    -webkit-mask-size: auto calc(12 * var(--px));
    mask-size: auto calc(12 * var(--px));
    -webkit-mask-repeat: repeat-x;
    mask-repeat: repeat-x;
    image-rendering: pixelated;
  }

  .edge-up {
    transform: scaleY(-1);
  }

  main {
    flex: 1;
    padding-top: 3rem;
  }

  .site-footer {
    margin-top: 6rem;
  }

  .foot {
    background: var(--chrome);
    color: var(--on-chrome);
  }

  .foot .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 2rem 2.5rem;
    font: 0.75rem/1.4 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1,
  h2 {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* Code keeps its case: uppercasing an identifier changes what it says. */
  :is(h1, h2) code {
    text-transform: none;
    letter-spacing: normal;
  }

  h1 {
    font-size: 2.5rem;
    line-height: 1.05;
    margin: 0 0 1rem;
  }

  .kicker {
    display: inline-block;
    margin: 0 0 1rem;
    padding: 0.4rem 0.5rem;
    background: var(--pop);
    color: var(--on-pop);
    font: 500 0.75rem/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .intro p {
    margin: 0 0 1rem;
  }

  .section-label {
    margin: 3rem 0 0;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--text);
    font: 500 0.75rem/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.9rem;
    color: var(--muted);
    font: 0.75rem/1.4 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .tag {
    padding: 0 0.3rem;
    background: var(--pop);
    color: var(--on-pop);
  }

  .arrow-link {
    display: inline-block;
    margin-top: 1.5rem;
    font: 500 0.8125rem/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .checker,
  .prose blockquote::before,
  .prose hr {
    background: var(--text);
    -webkit-mask: var(--checker-mask) 0 0 / 4px 4px repeat;
    mask: var(--checker-mask) 0 0 / 4px 4px repeat;
  }

  /* A Markdown `---` is the same checker break as the one under the intro. */
  .prose hr {
    height: 8px;
    margin: 2.5rem 0;
    border: 0;
  }

  /* The marker is positioned, not a flex item: a flex h2 would split inline
     code or links in the heading into separate items. */
  .prose h2 {
    --marker: 12px;
    --leading: 1.25em;
    position: relative;
    margin: 2.75rem 0 0.75rem;
    padding-left: calc(var(--marker) + 0.6rem);
    font-size: 1.25rem;
    line-height: var(--leading);
  }

  .prose h2::before {
    content: "";
    position: absolute;
    top: calc((var(--leading) - var(--marker)) / 2);
    left: 0;
    width: var(--marker);
    height: var(--marker);
    background: var(--pop);
  }

  .prose :where(p, ul, ol) {
    margin: 0 0 1.25rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose a {
    color: var(--pop-text);
    text-decoration: underline 2px;
    text-underline-offset: 3px;
  }

  .prose a:hover {
    background: var(--pop);
    color: var(--on-pop);
  }

  .prose code {
    padding: 0.1em 0.3em;
    background: color-mix(in srgb, var(--text) 7%, transparent);
    font: 0.85em var(--mono);
  }

  .prose img {
    max-width: 100%;
    height: auto;
  }

  /* Shiki (tokyo-night) sets the colours inline. */
  pre {
    margin: 0 0 1.5rem;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    font: 0.875rem/1.6 var(--mono);
  }

  .prose pre code {
    padding: 0;
    background: none;
    font: inherit;
  }

  .prose blockquote {
    position: relative;
    margin: 0 0 1.5rem;
    padding: 0.25rem 0 0.25rem 1.5rem;
    font-weight: 500;
  }

  .prose blockquote::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 8px;
  }

  .prose blockquote > :last-child {
    margin-bottom: 0;
  }

  @media (max-width: 40rem) {
    body {
      font-size: 1rem;
    }

    h1 {
      font-size: 1.875rem;
    }

    .site nav {
      gap: 1rem;
    }

    pre {
      padding: 1rem;
      font-size: 0.8125rem;
    }
  }

  @media (max-width: 22.5rem) {
    .site nav {
      gap: 0.625rem;
    }
  }
</style>
